# Gruber Darker notifications, the same look as the waybar popup.
# dunst layers this file over /etc/xdg/dunst/dunstrc, so only the theme is here.

[global]
    width = 340
    origin = top-right
    offset = (6, 4)
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#453d41"
    gap_size = 6
    separator_height = 1
    separator_color = "#282828"
    font = Hack Nerd Font Bold 10
    corner_radius = 8
    icon_corner_radius = 4
    min_icon_size = 24
    max_icon_size = 48
    highlight = "#ffdd33"

[urgency_low]
    background = "#181818"
    foreground = "#95a99f"
    frame_color = "#453d41"

[urgency_normal]
    background = "#181818"
    foreground = "#e4e4ef"
    frame_color = "#453d41"

[urgency_critical]
    background = "#181818"
    foreground = "#ff4f58"
    frame_color = "#f43841"
